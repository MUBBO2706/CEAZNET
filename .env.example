# Node.js environment flags
NODE_OPTIONS=--no-deprecation

# Supabase Configuration
SUPABASE_URL=default
SUPABASE_KEY=default
SUPABASE_SERVICE_ROLE_KEY=default
VITE_SUPABASE_URL=default
VITE_SUPABASE_ANON_KEY=default

# Supabase Groq Edge Logging (Optional)
SUPABASE_URL_GROQ=default
SUPABASE_KEY_GROQ=default

# Telegram Storage & Notification Bot Configuration
TELEGRAM_BOT_TOKEN=default
TELEGRAM_CHAT_ID=default
TELEGRAM_CACHE_CHAT_ID=default
VITE_TELEGRAM_BOT_TOKEN=default
VITE_TELEGRAM_CHAT_ID=default
VITE_TELEGRAM_CACHE_CHAT_ID=default

# Gemini AI API Key
GEMINI_API_KEY=default

# Task Manager API Key (Staging/Migrations)
TASK_MANAGER_API_KEY=default

